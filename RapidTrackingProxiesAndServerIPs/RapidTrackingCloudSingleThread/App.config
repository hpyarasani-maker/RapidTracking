<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IService1"
                    maxReceivedMessageSize="2147483647" />
                <binding name="BasicHttpsBinding_IService1">
                    <security mode="None" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://googlesourceservice.azurewebsites.net/Source.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IService1"
                contract="CloudSourceService.IService1" name="CloudSourceService.IService1" />
        </client>
    </system.serviceModel>
</configuration>